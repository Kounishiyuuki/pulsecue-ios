# Copy this file to `.dev.vars` for local `wrangler dev` runs.
# `.dev.vars` is git-ignored; this `.example` template is committed.
# Never put a real production secret in either file — use
# `wrangler secret put <NAME>` for production.

# Bearer token required for POST /api/gym-machines/import.
# Any non-empty value works locally; it just has to match the token
# you send in the `Authorization: Bearer` header while testing.
PULSECUE_IMPORT_API_KEY=local-dev-dummy-key

# HMAC-SHA256 signing secret used by POST /api/auth/import-token to
# mint short-lived bearer tokens. Must be different from
# PULSECUE_IMPORT_API_KEY. Any non-empty random-ish value works
# locally; production must use `wrangler secret put
# PULSECUE_IMPORT_TOKEN_SECRET` with a strong random value.
PULSECUE_IMPORT_TOKEN_SECRET=local-dev-token-signing-secret

# --- MOCK auth for POST /api/ai/training-plan (local/test only) ---
# OFF by default. Leave AI_TRAINING_PLAN_AUTH_MODE unset (or anything
# other than "mock") to keep the endpoint UNGATED, matching the default
# DEBUG loopback QA. When set to "mock", the route requires a fake
# `Authorization: Bearer` token matching one of the values below. These
# are NOT production auth and NOT provider keys — only clearly fake,
# local/test tokens. Never put a real secret or token here; production
# auth is a separate, approved step.
# AI_TRAINING_PLAN_AUTH_MODE=mock
# AI_TRAINING_PLAN_MOCK_VALID_TOKEN=fake-valid-ai-training-plan-token
# AI_TRAINING_PLAN_MOCK_EXPIRED_TOKEN=fake-expired-ai-training-plan-token
# AI_TRAINING_PLAN_MOCK_WRONG_SCOPE_TOKEN=fake-wrong-scope-ai-token

# --- pulsecue-api (accounts) ---
# Audience for Sign in with Apple identity tokens: the app's bundle
# identifier. NOT a secret — it ships inside the app — but it is
# environment-specific, so it is configured rather than compiled in.
# Verification refuses to run when this is unset, because an empty audience
# would mean "accept a token minted for any Apple client".
#
# No Apple secret belongs here. Verifying an identity token needs only
# Apple's public keys. The .p8 signing key / Key ID / Team ID are required
# for the /auth/revoke call Apple mandates at account deletion — a gate that
# must close before Apple sign-in ships publicly — and are introduced with
# that work rather than sitting here as placeholders.
APPLE_AUDIENCE=com.kounishiyuuki.pulsecue

# Audience for Google Sign-In ID tokens: the iOS OAuth client id from the
# Google Cloud console (the `...apps.googleusercontent.com` value). NOT a
# secret — it ships inside the app and appears in its URL scheme — but it is
# environment-specific, so it is configured rather than compiled in.
# Verification refuses to run when this is unset, because an empty audience
# would mean "accept a token minted for any Google client".
#
# No Google client secret belongs here. Verifying an ID token needs only
# Google's public keys, and the iOS app is a public OAuth client with no
# secret to begin with.
GOOGLE_AUDIENCE=REPLACE_WITH_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com
