# Copy this file to `.dev.vars` for local `wrangler dev` runs.
# `.dev.vars` is git-ignored; this `.example` template is committed.
# Never put a real production secret in either file — use
# `wrangler secret put <NAME>` for production.

# Bearer token required for POST /api/gym-machines/import.
# Any non-empty value works locally; it just has to match the token
# you send in the `Authorization: Bearer` header while testing.
PULSECUE_IMPORT_API_KEY=local-dev-dummy-key

# HMAC-SHA256 signing secret used by POST /api/auth/import-token to
# mint short-lived bearer tokens. Must be different from
# PULSECUE_IMPORT_API_KEY. Any non-empty random-ish value works
# locally; production must use `wrangler secret put
# PULSECUE_IMPORT_TOKEN_SECRET` with a strong random value.
PULSECUE_IMPORT_TOKEN_SECRET=local-dev-token-signing-secret

# --- MOCK auth for POST /api/ai/training-plan (local/test only) ---
# OFF by default. Leave AI_TRAINING_PLAN_AUTH_MODE unset (or anything
# other than "mock") to keep the endpoint UNGATED, matching the default
# DEBUG loopback QA. When set to "mock", the route requires a fake
# `Authorization: Bearer` token matching one of the values below. These
# are NOT production auth and NOT provider keys — only clearly fake,
# local/test tokens. Never put a real secret or token here; production
# auth is a separate, approved step.
# AI_TRAINING_PLAN_AUTH_MODE=mock
# AI_TRAINING_PLAN_MOCK_VALID_TOKEN=fake-valid-ai-training-plan-token
# AI_TRAINING_PLAN_MOCK_EXPIRED_TOKEN=fake-expired-ai-training-plan-token
# AI_TRAINING_PLAN_MOCK_WRONG_SCOPE_TOKEN=fake-wrong-scope-ai-token

# --- pulsecue-api (accounts) ---
# Audience for Sign in with Apple identity tokens: the app's bundle
# identifier. NOT a secret — it ships inside the app — but it is
# environment-specific, so it is configured rather than compiled in.
# Verification refuses to run when this is unset, because an empty audience
# would mean "accept a token minted for any Apple client".
#
# Verifying an identity token needs only Apple's public keys. Everything past
# verification — exchanging the authorization code, revoking at deletion —
# needs the settings below.
APPLE_AUDIENCE=com.kounishiyuuki.pulsecue

# --- Apple token lifecycle ---
#
# Required TOGETHER. With none set, POST /v1/auth/apple answers 503 rather
# than creating an account that could never be deleted the way Apple requires.
# With only some set, the request fails loudly instead of quietly behaving as
# though Apple were simply unconfigured.
#
# The first three are configuration rather than secrets — but they are still
# account-specific, so REAL VALUES DO NOT BELONG IN GIT. Set them as vars on
# the Worker; the placeholders here are for local runs only.
#
#   APPLE_CLIENT_ID  the app's bundle identifier / Services ID
#   APPLE_TEAM_ID    Apple Developer Team ID
#   APPLE_KEY_ID     Key ID of the Sign in with Apple .p8 key
APPLE_CLIENT_ID=com.kounishiyuuki.pulsecue
APPLE_TEAM_ID=REPLACE_WITH_APPLE_TEAM_ID
APPLE_KEY_ID=REPLACE_WITH_APPLE_KEY_ID

# PKCS#8 PEM text of the .p8 downloaded from the Apple Developer portal.
#
# THIS IS A SECRET. Never put a real key in this file or any committed file.
# In production:
#     npx wrangler secret put APPLE_PRIVATE_KEY --config wrangler.api.jsonc
# For a local run, generate a THROWAWAY P-256 key Apple has never seen:
#     openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
# It will not authenticate against Apple; it only exercises the code path.
APPLE_PRIVATE_KEY=

# AES-256-GCM key encrypting stored Apple refresh tokens: base64 of 32 random
# bytes. THIS IS A SECRET.
#     openssl rand -base64 32
#     npx wrangler secret put APPLE_TOKEN_ENCRYPTION_KEY --config wrangler.api.jsonc
#
# Rotation: bump _VERSION and move the old key to _PREVIOUS (decrypt-only)
# while a re-encrypt pass drains the old rows. Losing the key without a
# configured predecessor makes stored tokens unrevocable, so rotate
# deliberately.
APPLE_TOKEN_ENCRYPTION_KEY=
# APPLE_TOKEN_ENCRYPTION_KEY_VERSION=1
# APPLE_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# APPLE_TOKEN_ENCRYPTION_KEY_PREVIOUS_VERSION=

# Audience for Google Sign-In ID tokens: PulseCue's **Web application
# ("server") OAuth client id** from the Google Cloud console — the same value
# the iOS app sets as GIDServerClientID.
#
# NOT the iOS OAuth client id. Google Cloud issues two client ids for this
# setup and they are easy to swap by mistake:
#
#   iOS client id  -> GIDClientID, and the reversed-client-id URL scheme.
#                     Never appears in the ID token's `aud`.
#   Web/server     -> GIDServerClientID on the app side, GOOGLE_AUDIENCE here.
#     client id       This is what Google puts in `aud`.
#
# Putting the iOS client id here would reject every real token.
#
# Not a secret — a client id is public — but environment-specific, so it is
# configured rather than compiled in. Verification refuses to run when this is
# unset, because an empty audience would mean "accept a token minted for any
# Google client".
#
# No Google client secret belongs here. Verifying an ID token needs only
# Google's public keys; the backend never calls a Google token endpoint.
GOOGLE_AUDIENCE=REPLACE_WITH_WEB_SERVER_OAUTH_CLIENT_ID.apps.googleusercontent.com
