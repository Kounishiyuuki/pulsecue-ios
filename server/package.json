{
	"name": "pulsecue-server",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"cf-typegen": "wrangler types",
