		"check": "npm run typecheck && npm run typecheck:test && npm test"
	},
	"dependencies": {
		"hono": "^4.12.12",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.7.0",
		"typescript": "^5.6.3",
		"vitest": "^3.2.4",
		"wrangler": "^4.90.1"
	},
	"engines": {
		"node": ">=22.5.0"
	}
}
