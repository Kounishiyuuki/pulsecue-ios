<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kounishiyuuki.pulsecue.googlesignin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.376943003827-oai1mlkosmm8pv1ie94eelvcop3p6clu</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>376943003827-oai1mlkosmm8pv1ie94eelvcop3p6clu.apps.googleusercontent.com</string>
	<!--
	  The *second* Google client: the Web application ("server") OAuth client
	  id. Setting this makes Google mint the ID token with `aud` set to it,
	  which is what the PulseCue backend verifies against GOOGLE_AUDIENCE.

	  This is NOT the iOS client id above, and it gets NO reversed-client-id
	  URL scheme — it is not an app identity and nothing redirects to it.

	  Placeholder until the Web application client exists in Google Cloud.
	  While it is a placeholder, Google sign-in does not claim to have created
	  a PulseCue account.
	-->
	<key>GIDServerClientID</key>
	<string>YOUR_WEB_SERVER_CLIENT_ID.apps.googleusercontent.com</string>
	<!--
	  Base URL of the PulseCue account API. HTTPS only.

	  Placeholder until the Worker is deployed. While it is a placeholder the
	  account layer is simply unavailable: it connects nowhere, does not fall
	  back to localhost, and does not affect Guest or any local feature.
	-->
	<key>PulseCueAPIBaseURL</key>
	<string>https://YOUR_PULSECUE_API_HOST</string>
	<key>NSCameraUsageDescription</key>
	<string>食品バーコードを読み取るためにカメラを使用します。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>体重と睡眠時間の入力を補助するために、ヘルスケアのデータを読み取ります。読み取った値は画面に表示されるだけで、保存するかどうかはご自身で選べます。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ジム登録の際、近くのジムを検索するために位置情報を使います。現在地は近くのジム検索にのみ使用します。</string>
</dict>
</plist>
